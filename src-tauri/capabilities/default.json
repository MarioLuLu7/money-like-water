[
  {
    "$schema": "../gen/schemas/desktop-schema.json",
    "identifier": "default",
    "description": "Default permissions for the Money Like Water desktop shell.",
    "local": true,
    "windows": ["main", "meter"],
    "permissions": [
      "core:default",
      "core:window:default",
      "core:window:allow-start-dragging",
      "updater:default",
      "process:allow-restart",
      "allow-get-usage-snapshot",
      "allow-get-usage-snapshot-for-source",
      "allow-update-tray-tooltip",
      "allow-position-meter-window",
      "allow-toggle-meter-window",
      "allow-get-meter-settings",
      "allow-save-meter-settings",
      "allow-save-meter-layout-settings",
      "allow-get-chatgpt-access-token",
      "allow-fetch-ai-member-auth-token",
      "allow-set-ai-member-auth-token"
    ]
  },
  {
    "identifier": "ai-member-auth",
    "description": "Allow the AI-MEMBER login window to return localStorage.auth_token to the app.",
    "local": false,
    "remote": {
      "urls": ["https://proxy.ai-member.icu/*"]
    },
    "windows": ["ai-member-auth"],
    "permissions": ["allow-set-ai-member-auth-token"]
  }
]
